{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mettle.creed.space/schemas/evaluation-input-v1.json",
  "title": "METTLE privacy-minimal evaluation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "subject_class",
    "suite",
    "expected_pass",
    "observed_pass"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "subject_class": {
      "enum": ["becoming-mind", "human-assisted"]
    },
    "suite": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expected_pass": {"type": "boolean"},
    "observed_pass": {"type": "boolean"},
    "cohort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Aggregate, non-identifying cohort label only."
    }
  }
}
