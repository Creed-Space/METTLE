{
  "name": "mettle-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write \"src/**/*.{svelte,ts,js,css}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{svelte,ts,js,css}\" \"*.{js,ts,json}\"",
    "design:check": "impeccable detect src ../static"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "impeccable": "3.2.1",
    "prettier": "3.9.5",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "type": "module"
}
